# Template environment produksi. Salin, isi, dan JANGAN commit file hasil salinan.
#   cp apps/api/.env.production.example .env.prod

APP_NAME="Facility Reporting"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.contoh.ac.id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facility_reporting
DB_USERNAME=facility
DB_PASSWORD=ganti_dengan_password_kuat

# Database: pilih salah satu cara.
#
# 1. Sakala (database terkelola, ADR-020). Tiap deployment Sakala menyuntikkan
#    sendiri DATABASE_URL, DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE,
#    DB_USERNAME, dan DB_PASSWORD dari database yang di-attach ke proyek.
#    JANGAN menyalin nilainya ke Environment Variables proyek: variabel proyek
#    dengan nama sama MENANG atas suntikan Sakala, jadi DB_HOST=127.0.0.1 di
#    bawah akan menimpa host database dan koneksi pasti gagal. Cukup attach
#    database dari tab Database di Console, lalu jalankan migrasi lewat Release
#    command `php artisan migrate --force` (RUN_MIGRATIONS tetap false).
#
# 2. Server sendiri / platform lain: isi lima variabel DB_* di bawah, atau satu
#    connection string. Kalau `DB_URL` diisi, ia yang dipakai dan lima variabel
#    DB_* diabaikan; `DATABASE_URL` dibaca sebagai cadangan.
#   DB_URL=postgresql://user:sandi@host:5432/nama_db
#   DATABASE_URL=postgresql://user:sandi@host:5432/nama_db

# Driver session. `database` dipakai karena `artisan serve` (dan PHP-FPM
# multiproses) bisa menangani satu request lewat banyak proses; dengan driver
# `file` sesi login tidak konsisten terbaca pada request berikutnya.
# Tabel `sessions` sudah dibuat oleh migrasi bawaan.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true

# Frontend dan API di domain yang sama (termasuk subdomain): lax.
# Beda domain (mis. vercel.app + railway.app): none + secure.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Origin frontend, dipakai CORS.
FRONTEND_URL=https://app.contoh.ac.id

# Daftar host frontend yang boleh memakai cookie session (tanpa skema).
SANCTUM_STATEFUL_DOMAINS=app.contoh.ac.id

# Set true hanya saat deploy pertama / saat ada migrasi baru.
RUN_MIGRATIONS=false
